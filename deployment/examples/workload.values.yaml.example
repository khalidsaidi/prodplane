image:
  repository: registry.example.com/team/service
  tag: release-001
containerPort: 8080
env:
  - name: APP_MODE
    value: example
readinessProbe:
  tcpSocket:
    port: http
resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    memory: 256Mi
# Applications supply secret/config references, claims, routes and migration
# images as needed. None are required by this example.
