# Platform inputs only. Supply application definitions explicitly; empty maps create no workloads.
aws_region = "us-east-1"
cluster_environment = "prod"
node_group_desired_capacity = 4
node_group_max_capacity = 6
node_group_min_capacity = 3
node_instance_type = "t3a.2xlarge"
eks_version = "REPLACE_WITH_SUPPORTED_EKS_VERSION"
ssh_key_name = "prod-eks-ssh-key"
project_name = "prodplane"
state_bucket = "REPLACE_WITH_STATE_BUCKET"
state_region = "us-east-1"
state_key_prefix = "us-east-1/"
