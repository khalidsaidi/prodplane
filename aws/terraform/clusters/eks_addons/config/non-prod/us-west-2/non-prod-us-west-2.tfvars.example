# Platform inputs only. Supply application definitions explicitly; empty maps create no workloads.
aws_region = "us-west-2"
cluster_environment = "non-prod"
eks_cluster_name = ""
configure_aws_auth_configmap = true
fluentbit_http_server = "On"
fluentbit_http_port = 2020
fluentbit_read_from_head = "On"
fluentbit_storage_path = "/var/fluent-bit/state/flb-storage/"
project_name = "prodplane"
state_bucket = "REPLACE_WITH_STATE_BUCKET"
state_region = "us-west-2"
state_key_prefix = "us-west-2/"
