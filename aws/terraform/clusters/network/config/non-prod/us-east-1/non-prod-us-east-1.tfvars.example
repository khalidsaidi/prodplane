# Platform network; optional application connectivity is supplied through peering.
aws_region = "us-east-1"
cluster_environment = "non-prod"
vpc_cidr = "10.20.0.0/16"
availability_zones = [
  "us-east-1a",
  "us-east-1b"
]
private_subnet_cidrs = [
  "10.20.0.0/20",
  "10.20.16.0/20"
]
public_subnet_cidrs = [
  "10.20.32.0/24",
  "10.20.33.0/24"
]
bastion_ami_id = "ami-00000000000000000"
bastion_instance_type = "t2.medium"
bastion_key_name = "REPLACE_WITH_BASTION_KEY_NAME"
client_cidr_block = "172.27.0.0/22"
organization = "Example Organization"
domain_name = "vpn.example.com"
route53_zone_id = "REPLACE_WITH_ROUTE53_ZONE_ID"
vpn_users = {
  "operator": {
    "email": "operator@example.com"
  }
}
project_name = "prodplane"
state_bucket = "REPLACE_WITH_STATE_BUCKET"
state_region = "us-east-1"
state_key_prefix = "us-east-1/"
bastion_ssh_cidrs = [
  "192.0.2.10/32"
]
peering = null
efs_creation_token = "non-prod-environment-efs"
